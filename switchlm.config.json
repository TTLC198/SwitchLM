{
  "host": "127.0.0.1",
  "port": 8787,
  "bodyLimit": 16777216,
  "routing": {
    "mode": "heuristic",
    "solThreshold": 5,
    "trainingData": {
      "enabled": true,
      "capturePrompts": false,
      "requestFilePath": "C:/Users/me/.switchlm/routing-requests.jsonl",
      "maxRequestBytes": 262144,
      "minIntervalMs": 1000,
      "retentionDays": 30,
      "allowRequestPreview": false,
      "hmacKeyEnv": "SWITCHLM_TRAINING_HMAC_KEY"
    }
  },
  "providers": {
    "luna": {
      "type": "codex-chatgpt",
      "responsesUrl": "https://chatgpt.com/backend-api/codex/responses",
      "model": "gpt-5.6-luna",
      "account": "default"
    },
    "sol": {
      "type": "codex-chatgpt",
      "responsesUrl": "https://chatgpt.com/backend-api/codex/responses",
      "model": "gpt-5.6-sol",
      "account": "default"
    }
  },
  "logLevel": "info"
}
